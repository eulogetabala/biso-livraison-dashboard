# Mode API en dev : auto | local | prod
# auto  → localhost:3001 si /health OK, sinon VITE_API_URL (Render)
# local → toujours VITE_API_LOCAL_URL
# prod  → toujours VITE_API_URL
VITE_API_MODE=auto

# API en ligne (Render / prod Netlify)
VITE_API_URL=https://biso-api.onrender.com

# Backend local (npm run start:dev dans delivery-backend)
VITE_API_LOCAL_URL=http://localhost:3001
